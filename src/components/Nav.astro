---
import { client, telHref, url } from '../lib/client';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-brand-100">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16 md:h-20">
    <a href={url("/")} class="flex items-center gap-2 font-extrabold text-xl md:text-2xl text-brand-900">
      <span class="w-8 h-8 rounded-lg bg-brand-900 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 32 32">
          <path d="M16 6c-2 4-6 6-6 11a6 6 0 0 0 12 0c0-5-4-7-6-11z" fill="#ff6b1a"/>
        </svg>
      </span>
      {client.businessName}
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {client.navLinks.map(link => (
        <a href={url(link.href)} class="text-brand-700 hover:text-accent-500 font-semibold transition">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={telHref}
      class="hidden md:inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-5 py-2.5 rounded-lg transition shadow-lg shadow-accent-500/20"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      {client.phone}
    </a>

    <button id="menu-toggle" class="md:hidden p-2 text-brand-900" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-100 bg-white">
    <nav class="px-6 py-4 flex flex-col gap-1">
      {client.navLinks.map(link => (
        <a href={url(link.href)} class="py-3 text-brand-800 font-semibold border-b border-brand-50 last:border-0">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
