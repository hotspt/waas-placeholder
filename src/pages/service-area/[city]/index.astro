---
import '../../../styles/global.css';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { client, telHref, url } from '../../../lib/client';
import { breadcrumbSchema, localBusinessSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return client.serviceAreas.map(city => ({
    params: { city: city.toLowerCase().replace(/\s+/g, '-') },
    props: { city },
  }));
}

const { city } = Astro.props;

const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Service Areas', url: '/service-area' },
  { name: city, url: `/service-area/${city.toLowerCase().replace(/\s+/g, '-')}` },
]);
---

<Layout
  title={`${client.industry} Services in ${city}, ${client.address.state} | ${client.businessName}`}
  description={`Fast, honest ${client.industry.toLowerCase()} service in ${city}, ${client.address.state}. Same-day availability, upfront pricing, licensed & insured. Call ${client.phone}.`}
  canonical={`/service-area/${city.toLowerCase().replace(/\s+/g, '-')}`}
>
  <Nav />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  <section class="bg-brand-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute -top-40 right-0 w-96 h-96 rounded-full bg-accent-500 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-5 md:px-6 py-14 md:py-20">
      <nav class="text-brand-300 text-sm mb-4">
        <a href={url("/")} class="hover:text-accent-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">{city}</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight max-w-4xl">
        {client.industry} services in {city}, {client.address.state}
      </h1>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-brand-200 max-w-2xl">
        {client.businessName} proudly serves {city} homeowners with fast, honest {client.industry.toLowerCase()} service. Same-day availability, upfront pricing, and work guaranteed the first time.
      </p>
      <div class="mt-7 md:mt-8">
        <a
          href={telHref}
          class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 md:px-8 py-4 rounded-xl transition shadow-xl shadow-accent-500/30 active:scale-[0.98]"
        >
          Call {client.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-5 md:px-6">
      <h2 class="text-2xl md:text-4xl font-extrabold text-brand-900 tracking-tight mb-3">
        What we do in {city}
      </h2>
      <p class="text-brand-600 mb-8 md:mb-12 text-base md:text-lg max-w-2xl">
        Every service we offer, available to {city} homeowners.
      </p>

      <div class="grid gap-4 md:gap-6 md:grid-cols-2 lg:grid-cols-3">
        {client.services.map(svc => {
          const svcSlug = svc.href.replace('/services/', '');
          const citySlug = city.toLowerCase().replace(/\s+/g, '-');
          return (
            <a
              href={url(`/service-area/${citySlug}/${svcSlug}`)}
              class="group bg-white border border-brand-100 hover:border-accent-500 rounded-2xl p-6 md:p-8 transition hover:shadow-xl hover:shadow-brand-900/5 md:hover:-translate-y-1"
            >
              <h3 class="text-lg md:text-xl font-bold text-brand-900 mb-2 group-hover:text-accent-500 transition">
                {svc.title} in {city}
              </h3>
              <p class="text-brand-600 leading-relaxed text-sm md:text-base">{svc.desc}</p>
              <div class="mt-5 inline-flex items-center gap-1 text-accent-500 font-semibold text-sm group-hover:gap-2 transition-all">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-brand-50">
    <div class="max-w-4xl mx-auto px-5 md:px-6">
      <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 tracking-tight mb-6">
        Why {city} homeowners choose {client.businessName}
      </h2>
      <div class="space-y-4">
        {client.trustPoints.map(tp => (
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-accent-500 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div>
              <div class="text-brand-900 font-semibold">{tp.label}</div>
              <div class="text-brand-600 text-sm">{tp.detail}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-accent-500 blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-5 md:px-6 py-14 md:py-20 text-center">
      <h2 class="text-2xl md:text-4xl font-extrabold text-white tracking-tight">
        Need {client.industry.toLowerCase()} service in {city}?
      </h2>
      <p class="mt-4 text-base md:text-lg text-brand-200 max-w-2xl mx-auto">
        Call now — we serve {city} and can usually be at your door the same day.
      </p>
      <a
        href={telHref}
        class="mt-8 inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition shadow-xl shadow-accent-500/30 text-base md:text-lg active:scale-[0.98]"
      >
        Call {client.phone}
      </a>
    </div>
  </section>

  <Footer />
</Layout>
