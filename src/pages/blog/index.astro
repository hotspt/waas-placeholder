---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { client, telHref, url } from '../../lib/client';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title={`Blog | ${client.businessName} — ${client.address.city}, ${client.address.state}`}
  description={`Tips, guides, and advice from ${client.businessName}. Helping ${client.address.city} homeowners get the most out of their systems.`}
  canonical="/blog"
>
  <Nav />

  <section class="bg-brand-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute -top-40 right-0 w-96 h-96 rounded-full bg-accent-500 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-5 md:px-6 py-14 md:py-20">
      <nav class="text-brand-300 text-sm mb-4">
        <a href={url("/")} class="hover:text-accent-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Blog</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight max-w-4xl">
        Tips &amp; advice from {client.businessName}
      </h1>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-brand-200 max-w-2xl">
        Practical guides for {client.address.city} homeowners. Written by our team, based on what we see on service calls every day.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-5 md:px-6">
      {posts.length === 0 ? (
        <p class="text-brand-600">No posts yet.</p>
      ) : (
        <div class="space-y-6">
          {posts.map(post => (
            <a
              href={url(`/blog/${post.id}`)}
              class="block bg-white border border-brand-100 hover:border-accent-500 rounded-2xl p-6 md:p-8 transition hover:shadow-xl hover:shadow-brand-900/5"
            >
              <div class="text-xs md:text-sm text-brand-500 font-semibold uppercase tracking-wide mb-2">
                {formatDate(post.data.pubDate)}
              </div>
              <h2 class="text-xl md:text-2xl font-extrabold text-brand-900 mb-2 group-hover:text-accent-500 transition">
                {post.data.title}
              </h2>
              <p class="text-brand-600 leading-relaxed">
                {post.data.description}
              </p>
              <div class="mt-4 inline-flex items-center gap-1 text-accent-500 font-semibold text-sm">
                Read more
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="mt-14 bg-brand-50 border border-brand-100 rounded-2xl p-8 text-center">
        <h2 class="text-xl md:text-2xl font-extrabold text-brand-900">
          Need help right now?
        </h2>
        <p class="mt-3 text-brand-600 max-w-xl mx-auto">
          Reading is great. Calling is faster.
        </p>
        <a
          href={telHref}
          class="mt-6 inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 md:px-8 py-4 rounded-xl transition shadow-xl shadow-accent-500/30 active:scale-[0.98]"
        >
          Call {client.phone}
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
